+namespace {
+int Fetch_RGDS_Difficulty(char* description)
+{
+    const int w = 560;
+    const int h = 344;
+    const int x = (SeenBuff.Get_Width() - w) / 2;
+    const int y = (SeenBuff.Get_Height() - h) / 2;
+    auto* scheme = GadgetClass::Get_Color_Scheme();
+    Fancy_Text_Print(TXT_NONE, 0, 0, scheme, TBLACK, TPF_TEXT);
+    int text_width, text_height;
+    Format_Window_String(description, (w - 110) / 2, text_width, text_height);
+
+    const int button_width = (w - 110 - 21) / 2;
+    RGDSTextButtonClass okbutton(1, TXT_OK, TPF_BUTTON, x + 55 + button_width + 21,
+                                y + h - 55 - 34, button_width, 34);
+    RGDSTextButtonClass cancelbutton(3, TXT_CANCEL, TPF_BUTTON, x + 55,
+                                    y + h - 55 - 34, button_width, 34);
+    GadgetClass* buttons = &okbutton;
+    cancelbutton.Add(*buttons);
+    SliderClass slider(2, x + 55, y + 178, w - 110, 34, true);
+    slider.Set_Maximum(Rule.IsFineDifficulty ? 5 : 3);
+    slider.Set_Value(Rule.IsFineDifficulty ? 2 : 1);
+    slider.Add(*buttons);
+    okbutton.Turn_On();
+    Keyboard->Clear();
+    Set_Logic_Page(SeenBuff);
+    bool redraw = true;
+    while (true) {
+        if (redraw) {
+            redraw = false;
+            Hide_Mouse();
+            Dialog_Box(x, y, w, h);
+            Set_Logic_Page(HidPage);
+            int line_y = y + 34;
+            for (char* line = description; line && *line;) {
+                char* end = strchr(line, '\r');
+                if (end) {
+                    *end = '\0';
+                }
+                RGDS_Draw_Large_Text(line, x + 55, line_y, w - 110, 34,
+                                     TPF_USE_GRAD_PAL | TPF_BRIGHT_COLOR);
+                line_y += 34;
+                if (end) {
+                    *end = '\r';
+                }
+                line = end ? end + 1 : nullptr;
+            }
+            const int labels[] = {TXT_EASY, TXT_NORMAL, TXT_HARD};
+            const int value = slider.Get_Value();
+            const int middle = Rule.IsFineDifficulty ? 2 : 1;
+            for (int i = 0; i < 3; ++i) {
+                const auto flags = TPF_USE_GRAD_PAL | (value == i * middle ? TPF_BRIGHT_COLOR : TPF_MEDIUM_COLOR);
+                RGDS_Draw_Large_Text(Text_String(labels[i]), slider.X + i * slider.Width / 3,
+                                     y + 131, slider.Width / 3, 34, flags, true);
+            }
+            buttons->Draw_All(true);
+            HidPage.Blit(SeenBuff, x, y, x, y, w, h, false);
+            Set_Logic_Page(SeenBuff);
+            Show_Mouse();
+        }
+        Call_Back();
+        if (AllSurfaces.SurfacesRestored) {
+            AllSurfaces.SurfacesRestored = false;
+            redraw = true;
+        }
+        const int previous = slider.Get_Value();
+        switch (buttons->Input()) {
+        case KN_ESC:
+        case (3 | BUTTON_FLAG):
+            Keyboard->Clear();
+            fprintf(stderr, "RGDS difficulty: cancel\n");
+            return -1;
+        case KN_RETURN:
+        case (1 | BUTTON_FLAG): {
+            const int difficulty = slider.Get_Value() * (Rule.IsFineDifficulty ? 1 : 2);
+            Keyboard->Clear();
+            fprintf(stderr, "RGDS difficulty: value=%d\n", difficulty);
+            return difficulty;
+        }
+        case KN_LEFT:
+            slider.Step(true);
+            break;
+        case KN_RIGHT:
+            slider.Step(false);
+            break;
+        default:
+            break;
+        }
+        redraw |= previous != slider.Get_Value();
+        Frame_Limiter();
+    }
+}
+}
