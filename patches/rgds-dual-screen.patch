diff --git a/redalert/rgds_threat.cpp b/redalert/rgds_threat.cpp
new file mode 100644
index 0000000..698ee70
--- /dev/null
+++ b/redalert/rgds_threat.cpp
@@ -0,0 +1,165 @@
+#include "rgds_threat.h"
+#ifdef RED_ALERT_DS_PLUS
+#include "function.h"
+#include "rgds_workers.h"
+#include "common/parallel_scan.h"
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace {
+static_assert(HOUSE_COUNT <= 32, "Threat recipient mask must fit all houses");
+const int Capacity = 512;
+struct Event { uint32_t recipients; int region, value; };
+struct State {
+    Event events[Capacity];
+    HouseClass* houses[HOUSE_COUNT] = {};
+    int active[HOUSE_COUNT] = {}, active_count = 0;
+    int count = 0, depth = 0;
+    bool valid = false;
+    int mode = 2;
+    bool verify = std::getenv("RED_ALERT_DS_PLUS_VERIFY_THREAT") != nullptr;
+    bool stats = std::getenv("RED_ALERT_DS_PLUS_THREAT_STATS") != nullptr;
+    uint64_t queued = 0, batches = 0, parallel = 0, checked = 0;
+    State()
+    {
+        const char* option = std::getenv("RED_ALERT_DS_PLUS_THREAT_MODE");
+        if (option && std::strcmp(option, "legacy") == 0) mode = 0;
+        else if (option && std::strcmp(option, "serial") == 0) mode = 1;
+    }
+    ~State()
+    {
+        if (stats) std::fprintf(stderr,
+            "THREAT_BATCH mode=%d events=%llu batches=%llu parallel=%llu checked=%llu pending=%d frame=%d\n",
+            mode, (unsigned long long)queued, (unsigned long long)batches,
+            (unsigned long long)parallel, (unsigned long long)checked, count, Frame);
+    }
+};
+State& Batch() { static State state; return state; }
+
+void Apply(void* context, int begin, int end, int)
+{
+    State& state = *static_cast<State*>(context);
+    // Each house belongs to one lane. Event order within its table stays intact.
+    for (int index = begin; index < end; ++index) {
+        const int house = state.active[index];
+        for (int i = 0; i < state.count; ++i) {
+            const Event& event = state.events[i];
+            if (event.recipients & (uint32_t(1) << house))
+                state.houses[house]->Adjust_Threat(event.region, event.value);
+        }
+    }
+}
+
+void Reference(RegionClass* table, const Event& event)
+{
+    const int offsets[] = {-MAP_REGION_WIDTH - 1, -MAP_REGION_WIDTH, -MAP_REGION_WIDTH + 1,
+                          -1, 0, 1, MAP_REGION_WIDTH - 1, MAP_REGION_WIDTH, MAP_REGION_WIDTH + 1};
+    const int shifts[] = {2, 1, 2, 1, 0, 1, 2, 1, 2};
+    const bool negative = event.value < 0;
+    const int value = negative ? -event.value : event.value;
+    for (int i = 0; i < 9; ++i) table[event.region + offsets[i]].Adjust_Threat(value >> shifts[i], negative);
+}
+}
+#endif
+
+void RGDS_Begin_Threat()
+{
+#ifdef RED_ALERT_DS_PLUS
+    if (RGDS_Video_Enabled() && Batch().mode) ++Batch().depth;
+#endif
+}
+
+void RGDS_End_Threat()
+{
+#ifdef RED_ALERT_DS_PLUS
+    State& state = Batch();
+    if (state.depth) { RGDS_Flush_Threat(); --state.depth; }
+#endif
+}
+
+void RGDS_Reset_Threat_Houses()
+{
+#ifdef RED_ALERT_DS_PLUS
+    RGDS_Flush_Threat();
+    Batch().valid = false;
+#endif
+}
+
+bool RGDS_Queue_Threat(int owner, int region, int value)
+{
+#ifdef RED_ALERT_DS_PLUS
+    State& state = Batch();
+    if (!state.depth) return false;
+    if (!state.valid) {
+        std::memset(state.houses, 0, sizeof(state.houses));
+        for (int i = 0; i < Houses.Count(); ++i) {
+            HouseClass* house = Houses.Ptr(i);
+            const int id = house->Class->House;
+            if (id >= 0 && id < HOUSE_COUNT && !state.houses[id]) state.houses[id] = house;
+        }
+        state.active_count = 0;
+        for (int id = HOUSE_FIRST; id < HOUSE_COUNT; ++id)
+            if (state.houses[id]) state.active[state.active_count++] = id;
+        state.valid = true;
+    }
+    uint32_t recipients = 0;
+    for (int id = HOUSE_FIRST; id < HOUSE_COUNT; ++id) {
+        const HouseClass* house = state.houses[id];
+        if (id != owner && house && (!house->IsHuman || !house->Is_Ally(static_cast<HousesType>(owner))))
+            recipients |= uint32_t(1) << id;
+    }
+    if (state.verify) {
+        uint32_t reference = 0;
+        for (HousesType id = HOUSE_FIRST; id < HOUSE_COUNT; id++) {
+            HouseClass* house = HouseClass::As_Pointer(id);
+            if (id != owner && house && (!house->IsHuman || !house->Is_Ally(static_cast<HousesType>(owner))))
+                reference |= uint32_t(1) << id;
+        }
+        if (reference != recipients) std::abort();
+    }
+    state.events[state.count++] = {recipients, region, value};
+    ++state.queued;
+    if (state.count == Capacity) RGDS_Flush_Threat();
+    return true;
+#else
+    return false;
+#endif
+}
+
+void RGDS_Flush_Threat()
+{
+#ifdef RED_ALERT_DS_PLUS
+    State& state = Batch();
+    if (!state.count) return;
+    std::vector<RegionClass> reference;
+    if (state.verify) {
+        reference.resize(HOUSE_COUNT * MAP_TOTAL_REGIONS);
+        for (int id = HOUSE_FIRST; id < HOUSE_COUNT; ++id)
+            if (state.houses[id]) std::memcpy(&reference[id * MAP_TOTAL_REGIONS], state.houses[id]->Regions,
+                                             sizeof(state.houses[id]->Regions));
+        // Replay the original event-first order on an independent copy.
+        for (int i = 0; i < state.count; ++i)
+            for (int id = HOUSE_FIRST; id < HOUSE_COUNT; ++id)
+                if (state.events[i].recipients & (uint32_t(1) << id))
+                    Reference(&reference[id * MAP_TOTAL_REGIONS], state.events[i]);
+    }
+    ParallelScan* pool = state.mode == 2 && state.count >= 128 ? RGDS_Workers() : nullptr;
+    if (pool) { pool->Run(state.active_count, Apply, &state); ++state.parallel; }
+    else Apply(&state, 0, state.active_count, 0);
+    if (state.verify) {
+        for (int id = HOUSE_FIRST; id < HOUSE_COUNT; ++id) {
+            if (state.houses[id] && std::memcmp(&reference[id * MAP_TOTAL_REGIONS], state.houses[id]->Regions,
+                                               sizeof(state.houses[id]->Regions))) {
+                std::fprintf(stderr, "Threat table mismatch at frame %d house %d\n", Frame, id);
+                std::abort();
+            }
+        }
+        ++state.checked;
+    }
+    ++state.batches;
+    state.count = 0;
+#endif
+}
