+bool RGDS_Status_Update_Due()
+{
+    return RGDS_Video_Enabled() && status_renderer && Sint32(SDL_GetTicks() - status_deadline) >= 0;
+}
+
+static void Update_Status(const void* pixels, int pitch, int width, int height, const SDL_Color* colors)
+{
+    if (!RGDS_Video_Enabled() || !status_renderer || !pixels || !colors
+        || width <= 0 || height <= 0 || width > 1024 || height > 768
+        || pitch < width) {
+        return;
+    }
+    if (!status_indexed || status_indexed->w != width || status_indexed->h != height) {
+        SDL_DestroyTexture(status_texture);
+        SDL_FreeSurface(status_rgba);
+        SDL_FreeSurface(status_indexed);
+        status_indexed = SDL_CreateRGBSurfaceWithFormat(0, width, height, 8, SDL_PIXELFORMAT_INDEX8);
+        status_rgba = SDL_CreateRGBSurfaceWithFormat(0, width, height, 32, SDL_PIXELFORMAT_ARGB8888);
+        status_texture = SDL_CreateTexture(status_renderer, SDL_PIXELFORMAT_ARGB8888,
+                                          SDL_TEXTUREACCESS_STREAMING, width, height);
+        if (!status_indexed || !status_rgba || !status_texture) {
+            SDL_LogError(SDL_LOG_CATEGORY_APPLICATION, "RGDS status allocation failed: %s", SDL_GetError());
+            std::exit(EXIT_FAILURE);
+        }
+        status_colors_valid = false;
+        status_conversion = IndexedPaletteCache();
+    }
+    bool changed = !status_colors_valid || std::memcmp(status_colors, colors, sizeof(status_colors)) != 0;
+    if (changed) {
+        std::memcpy(status_colors, colors, sizeof(status_colors));
+        SDL_SetPaletteColors(status_indexed->format->palette, colors, 0, 256);
+        status_colors_valid = true;
+    }
+    for (int y = 0; y < height; ++y) {
+        auto* dst = static_cast<uint8_t*>(status_indexed->pixels) + y * status_indexed->pitch;
+        const auto* src = static_cast<const uint8_t*>(pixels) + y * pitch;
+        if (std::memcmp(dst, src, width) != 0) {
+            std::memcpy(dst, src, width);
+            changed = true;
+        }
+    }
+    status_deadline = SDL_GetTicks() + status_interval;
+    status_dirty |= changed;
+}
+
+void RGDS_Update_Status(const void* pixels, int pitch, int width, int height, bool framed_radar)
+{
+    status_interval = 100;
+    if (RGDS_Status_Update_Due()) {
+        status_dirty |= status_framed_radar != framed_radar;
+        status_framed_radar = framed_radar;
+        Update_Status(pixels, pitch, width, height, palette->colors);
+    }
+}
+
+void RGDS_Update_Menu_Video(const void* pixels, int pitch, int width, int height, const uint8_t* colors)
+{
+    if (!colors) {
+        return;
+    }
+    SDL_Color converted[256];
+    for (int i = 0; i < 256; ++i) {
+        converted[i] = {static_cast<Uint8>(colors[i * 3] << 2),
+                        static_cast<Uint8>(colors[i * 3 + 1] << 2),
+                        static_cast<Uint8>(colors[i * 3 + 2] << 2), SDL_ALPHA_OPAQUE};
+    }
+    status_dirty |= status_framed_radar;
+    status_framed_radar = false;
+    status_interval = 0;
+    status_present_deadline = SDL_GetTicks();
+    Update_Status(pixels, pitch, width, height, converted);
+}
+
+static void Draw_Status_Radar_Frame(const SDL_Rect& output)
+{
+    if (!status_radar_frame) {
+        const int width = RGDS_UI_W, height = RGDS_UI_H;
+        const int split = RGDS_RADAR_SIZE, border = RGDS_RADAR_BORDER;
+        SDL_Surface* frame = SDL_CreateRGBSurfaceWithFormat(0, width, height, 32, SDL_PIXELFORMAT_ARGB8888);
+        if (!frame) return;
+        SDL_FillRect(frame, nullptr, 0);
+        auto* pixels = static_cast<Uint32*>(frame->pixels);
+        const int stride = frame->pitch / sizeof(Uint32);
+        for (int y = 0; y < height; ++y) for (int x = 0; x < width; ++x) {
+            int edge = std::min(std::min(x, width - 1 - x), std::min(y, height - 1 - y));
+            if (edge >= border && y >= split - border && y < split) edge = split - 1 - y;
+            if (edge >= border && y < split && x >= split - border && x < split) edge = split - 1 - x;
+            if (edge >= border) continue;
+            const int grain = ((x * 17 + y * 29) ^ (x * y)) & 15;
+            const int shade = edge == 0 ? (x == 0 || y == 0 ? 192 + grain : 24)
+                : (edge == 1 ? 192 + grain : (edge < 4 ? 112 + grain * 3 : 48 + grain));
+            pixels[y * stride + x] = edge == border - 1 ? 0xff1d378au
+                : 0xff000000u | (shade << 16) | (shade << 8) | shade;
+        }
+        const int screws[][2] = {{3, 3}, {split - 3, 3}, {width - 4, 3},
+            {3, split - 3}, {split - 3, split - 3}, {width - 4, split - 3},
+            {3, height - 4}, {width - 4, height - 4}};
+        for (const auto& screw : screws) {
+            for (int y = -2; y <= 2; ++y) for (int x = -2; x <= 2; ++x) {
+                if (x * x + y * y > 4) continue;
+                pixels[(screw[1] + y) * stride + screw[0] + x] = x == y ? 0xff34302au
+                    : (x + y < 0 ? 0xffd0bd83u : 0xff82734fu);
+            }
+        }
+        status_radar_frame = SDL_CreateTextureFromSurface(status_renderer, frame);
+        SDL_FreeSurface(frame);
+        if (!status_radar_frame) return;
+        SDL_SetTextureBlendMode(status_radar_frame, SDL_BLENDMODE_BLEND);
+    }
+    SDL_Rect frame{output.x, output.y, output.w, output.h};
+    SDL_RenderCopy(status_renderer, status_radar_frame, nullptr, &frame);
+}
+
+static void Render_Status()
+{
+    if (!status_dirty || !status_renderer || !status_texture
+        || Sint32(SDL_GetTicks() - status_present_deadline) < 0) {
+        return;
+    }
+    if (!Convert_RGDS_Region(status_indexed, status_rgba, {0, 0, status_indexed->w, status_indexed->h}, status_conversion))
+        SDL_BlitSurface(status_indexed, nullptr, status_rgba, nullptr);
+    SDL_UpdateTexture(status_texture, nullptr, status_rgba->pixels, status_rgba->pitch);
+    int w, h;
+    SDL_GetRendererOutputSize(status_renderer, &w, &h);
+    SDL_Rect dst = {0, 0, w, w * status_rgba->h / status_rgba->w};
+    if (dst.h > h) {
+        dst.h = h;
+        dst.w = h * status_rgba->w / status_rgba->h;
+    }
+    dst.x = (w - dst.w) / 2;
+    dst.y = (h - dst.h) / 2;
+    SDL_RenderClear(status_renderer);
+    SDL_RenderCopy(status_renderer, status_texture, nullptr, &dst);
+    if (status_framed_radar) Draw_Status_Radar_Frame(dst);
+    SDL_RenderPresent(status_renderer);
+    status_present_deadline = SDL_GetTicks() + status_interval;
+    status_dirty = false;
+}
+
+void RGDS_Invalidate_Status(uint32_t window_id)
