+// Keep the existing HUD zones while drawing its text at the panel's native resolution.
+int RGDS_Status_Pixel(int coordinate) { return coordinate * 8 / 5; }
+
+void RGDS_Text_Block(GraphicBufferClass& source, GraphicBufferClass& target, int x, int y, int width, int height)
+{
+    const auto* ink = static_cast<const unsigned char*>(source.Get_Buffer());
+    const int sw = source.Get_Width(), sh = source.Get_Height();
+    int min_x = sw, min_y = sh, max_x = -1, max_y = -1;
+    for (int py = 0; py < sh; ++py) for (int px = 0; px < sw; ++px) {
+        if (!ink[py * sw + px]) continue;
+        min_x = std::min(min_x, px); max_x = std::max(max_x, px);
+        min_y = std::min(min_y, py); max_y = std::max(max_y, py);
+    }
+    if (max_x < min_x || max_y < min_y) return;
+    const int w = max_x - min_x + 1, h = max_y - min_y + 1;
+    x = RGDS_Status_Pixel(x); y = RGDS_Status_Pixel(y);
+    width = RGDS_Status_Pixel(width); height = RGDS_Status_Pixel(height);
+    const int dw = w * 2, dh = h * 2;
+    source.Scale(target, min_x, min_y, x + (width - dw) / 2, y + (height - dh) / 2, w, h, dw, dh, false);
+}
