+namespace {
+class RGDSMenuMovie
+{
+public:
+    RGDSMenuMovie()
+    {
+        if (RGDS_Video_Enabled()) {
+            for (const char* candidate : {"ENGLISH.VQA", "REDINTRO.VQA"}) {
+                if (CCFileClass(candidate).Is_Available()) {
+                    filename = candidate;
+                    Open();
+                    break;
+                }
+            }
+        }
+    }
+
+    ~RGDSMenuMovie() { Close(); }
+    RGDSMenuMovie(const RGDSMenuMovie&) = delete;
+    RGDSMenuMovie& operator=(const RGDSMenuMovie&) = delete;
+
+    bool Update()
+    {
+        if (!handle) {
+            return false;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        if (now < next_frame) {
+            return true;
+        }
+        if (frame == handle->Header.Frames) {
+            Close();
+            if (!Open()) {
+                return false;
+            }
+        }
+        if (VQA_DecodeFrame(handle) != VQAERR_NONE) {
+            fprintf(stderr, "RGDS menu intro decode failed: frame=%d\n", frame);
+            Close();
+            return false;
+        }
+        VQAInfo info;
+        VQA_GetInfo(handle, &info);
+        RGDS_Update_Menu_Video(info.ImageBuf, info.ImageWidth, info.ImageWidth, info.ImageHeight,
+                               VQA_GetPalette(handle));
+        ++frame;
+        const auto period = std::chrono::microseconds(1000000 / handle->Header.FPS);
+        next_frame += period;
+        if (next_frame + period * 4 < now) {
+            next_frame = now + period;
+        }
+        return true;
+    }
+
+private:
+    bool Open()
+    {
+        VQAConfig config;
+        VQA_DefaultConfig(&config);
+        config.OptionFlags = 0;
+        config.DrawFlags = VQACFGF_BUFFER | VQACFGF_NOSKIP;
+        handle = VQA_Alloc();
+        if (!handle) {
+            return false;
+        }
+        VQA_Init(handle, MixFileHandler);
+        if (VQA_Open(handle, filename, &config) != VQAERR_NONE) {
+            fprintf(stderr, "RGDS menu intro open failed: %s\n", filename);
+            VQA_Free(handle);
+            handle = nullptr;
+            return false;
+        }
+        const auto& header = handle->Header;
+        if (!header.FPS || !header.Frames || !header.ImageWidth || !header.ImageHeight
+            || header.ImageWidth > 640 || header.ImageHeight > 480 || header.ColorMode != COLORMODE_256) {
+            Close();
+            return false;
+        }
+        handle->Config.OptionFlags = VQAOPTF_SINGLESTEP | VQAOPTF_PRIVATE_PALETTE;
+        frame = 0;
+        next_frame = std::chrono::steady_clock::now();
+        fprintf(stderr, "RGDS menu intro: %s %dx%d fps=%d frames=%d loop=%d\n", filename,
+                header.ImageWidth, header.ImageHeight, header.FPS, header.Frames, ++loops);
+        return true;
+    }
+
+    void Close()
+    {
+        if (handle) {
+            VQA_Close(handle);
+            VQA_Free(handle);
+            handle = nullptr;
+        }
+    }
+
+    VQAHandle* handle = nullptr;
+    const char* filename = nullptr;
+    int frame = 0;
+    int loops = 0;
+    std::chrono::steady_clock::time_point next_frame;
+};
+
+GraphicBufferClass& RGDS_Menu_Logo()
+{
+    static GraphicBufferClass logo(320, 240);
+    return logo;
+}
+
+void Draw_RGDS_Menu_Background()
+{
+    auto* scheme = GadgetClass::Get_Color_Scheme();
+    auto& logo = RGDS_Menu_Logo();
+    logo.Clear();
+    // The original title fills a 4:3 display, including its non-square pixel correction.
+    HidPage.Scale(logo, 0, 0, 0, 0, SeenBuff.Get_Width(), SeenBuff.Get_Height(), 320, 240);
+    HidPage.Clear();
+    const int w = HidPage.Get_Width();
+    const int h = HidPage.Get_Height();
+    for (int x = 0; x < w; x += 40) {
+        HidPage.Draw_Line(x, 0, x, h - 1, scheme->Shadow);
+    }
+    for (int y = 0; y < h; y += 40) {
+        HidPage.Draw_Line(0, y, w - 1, y, scheme->Shadow);
+    }
+    HidPage.Draw_Rect(12, 12, w - 13, h - 13, scheme->Highlight);
+}
+}
