diff --git a/tests/indexed_blit.cpp b/tests/indexed_blit.cpp
new file mode 100644
index 0000000..e71eaa1
--- /dev/null
+++ b/tests/indexed_blit.cpp
@@ -0,0 +1,98 @@
+#include "common/indexed_blit.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+#include <algorithm>
+
+static unsigned random_state = 0x18534ba9;
+static unsigned Random()
+{
+    random_state ^= random_state << 13;
+    random_state ^= random_state >> 17;
+    random_state ^= random_state << 5;
+    return random_state;
+}
+static void Require(bool value, const char* description)
+{
+    if (!value) { std::fprintf(stderr, "%s: %s\n", description, SDL_GetError()); std::exit(1); }
+}
+static void Compare(int width, int height, Uint32 format, bool parallel)
+{
+    const int source_pitch = width + 5, destination_pitch = (width + 7) * 4;
+    std::vector<Uint8> input(source_pitch * height + 32, 0x6d);
+    std::vector<Uint8> actual(destination_pitch * height + 32, 0x6d), expected = actual;
+    SDL_Surface* source = SDL_CreateRGBSurfaceWithFormatFrom(input.data() + 16, width, height, 8, source_pitch, SDL_PIXELFORMAT_INDEX8);
+    SDL_Surface* target = SDL_CreateRGBSurfaceWithFormatFrom(actual.data() + 16, width, height, 32, destination_pitch, format);
+    SDL_Surface* reference = SDL_CreateRGBSurfaceWithFormatFrom(expected.data() + 16, width, height, 32, destination_pitch, format);
+    Require(source && target && reference, "allocate surfaces");
+    for (int y = 0; y < height; ++y) for (int x = 0; x < width; ++x)
+        input[16 + y * source_pitch + x] = static_cast<Uint8>(Random());
+    SDL_Color palette[256];
+    for (auto& color : palette) color = {Uint8(Random()), Uint8(Random()), Uint8(Random()), Uint8(Random())};
+    palette[0].a = 0;
+    palette[1].a = 255;
+    IndexedPaletteCache cache;
+    for (int pass = 0; pass < 5; ++pass) {
+        if (pass % 2 == 0) {
+            palette[0].r ^= 0xa5;
+            palette[255].g ^= 0x93;
+            Require(SDL_SetPaletteColors(source->format->palette, palette, 0, 256) == 0, "change palette");
+        }
+        std::fill(actual.begin(), actual.end(), 0x6d);
+        std::fill(expected.begin(), expected.end(), 0x6d);
+        const int x = std::min(3, width - 1), y = std::min(2, height - 1);
+        SDL_Rect region = pass % 2 ? SDL_Rect{x, y, width - x, height - y} : SDL_Rect{0, 0, width, height};
+        SDL_Rect destination = region, source_region = region;
+        Require(SDL_BlitSurface(source, &source_region, reference, &destination) == 0, "reference blit");
+        auto result = Convert_Indexed_Region(source, target, region, cache, parallel, true);
+        Require(result.converted && result.verified, "convert region");
+        Require(result.parallel == (parallel && size_t(region.w) * region.h >= 131072), "worker threshold");
+        if (actual != expected) {
+            std::fprintf(stderr, "Pixel difference %dx%d format=%u pass=%d parallel=%d\n", width, height, format, pass, parallel);
+            std::exit(1);
+        }
+    }
+    auto unchanged = actual;
+    SDL_Rect region{0, 0, width, height};
+    SDL_SetColorKey(source, SDL_TRUE, 1);
+    Require(!Convert_Indexed_Region(source, target, region, cache, true, true).converted, "color key fallback");
+    SDL_SetColorKey(source, SDL_FALSE, 0);
+    SDL_SetSurfaceColorMod(source, 128, 255, 255);
+    Require(!Convert_Indexed_Region(source, target, region, cache, true, true).converted, "color modulation fallback");
+    SDL_SetSurfaceColorMod(source, 255, 255, 255);
+    SDL_SetSurfaceAlphaMod(source, 127);
+    Require(!Convert_Indexed_Region(source, target, region, cache, true, true).converted, "alpha modulation fallback");
+    SDL_SetSurfaceAlphaMod(source, 255);
+    SDL_SetSurfaceBlendMode(source, SDL_BLENDMODE_BLEND);
+    Require(!Convert_Indexed_Region(source, target, region, cache, true, true).converted, "blend fallback");
+    SDL_SetSurfaceBlendMode(source, SDL_BLENDMODE_NONE);
+    SDL_Rect clip{0, 0, width - 1, height};
+    SDL_SetClipRect(target, &clip);
+    Require(!Convert_Indexed_Region(source, target, region, cache, true, true).converted, "clipped fallback");
+    SDL_SetClipRect(target, nullptr);
+    Require(!Convert_Indexed_Region(source, target, {0, 0, 0, height}, cache, true, true).converted, "empty fallback");
+    Require(!Convert_Indexed_Region(source, target, {-1, 0, width, height}, cache, true, true).converted, "outside fallback");
+    Require(!Convert_Indexed_Region(nullptr, target, region, cache, true, true).converted, "null fallback");
+    Require(actual == unchanged, "fallback must not write");
+    SDL_FreeSurface(source); SDL_FreeSurface(target); SDL_FreeSurface(reference);
+}
+int main()
+{
+    const Uint32 formats[] = {SDL_PIXELFORMAT_ARGB8888, SDL_PIXELFORMAT_ABGR8888,
+                             SDL_PIXELFORMAT_RGBA8888, SDL_PIXELFORMAT_RGB888};
+    for (Uint32 format : formats) {
+        for (int width : {1, 2, 3, 7, 31, 257}) for (int height : {1, 2, 17})
+            Compare(width, height, format, false);
+        Compare(1024, 768, format, true);
+        Compare(1281, 961, format, true);
+    }
+    std::vector<Uint32> pixels(128 * 4);
+    SDL_Surface* source = SDL_CreateRGBSurfaceWithFormatFrom(pixels.data(), 128, 4, 8, 128, SDL_PIXELFORMAT_INDEX8);
+    SDL_Surface* destination = SDL_CreateRGBSurfaceWithFormatFrom(pixels.data(), 128, 4, 32, 512, SDL_PIXELFORMAT_ARGB8888);
+    Require(source && destination, "alias surfaces");
+    IndexedPaletteCache cache;
+    Require(!Convert_Indexed_Region(source, destination, {0, 0, 128, 4}, cache, true, true).converted, "alias fallback");
+    SDL_FreeSurface(source); SDL_FreeSurface(destination);
+    std::puts("indexed conversion matches SDL, palette changes and padded crops; fallbacks unchanged");
+}
diff --git a/tests/rgds_limits.cpp b/tests/rgds_limits.cpp
new file mode 100644
index 0000000..550e3c2
--- /dev/null
+++ b/tests/rgds_limits.cpp
@@ -0,0 +1,75 @@
+#include "redalert/rgds_limits.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+static void Require(bool condition, const char* message)
+{
+    if (!condition) { std::fprintf(stderr, "%s\n", message); std::exit(1); }
+}
+
+struct Heap;
+struct Object {
+    Heap& heap;
+    explicit Object(Heap& owner) : heap(owner) {}
+    ~Object();
+};
+struct Heap {
+    int capacity, destroyed = 0;
+    std::vector<Object*> objects;
+    explicit Heap(int length) : capacity(length) {}
+    ~Heap() { while (!objects.empty()) delete objects.back(); }
+    int Length() const { return capacity; }
+    int Count() const { return static_cast<int>(objects.size()); }
+    Object* Ptr(int index) const {
+        Require(index >= 0 && index < Count(), "reservation used an inactive index");
+        return objects[index];
+    }
+    bool Add(int allocation_limit) {
+        if (Count() >= allocation_limit || Count() >= capacity) return false;
+        objects.push_back(new Object(*this));
+        return true;
+    }
+};
+Object::~Object()
+{
+    heap.objects.erase(std::find(heap.objects.begin(), heap.objects.end(), this));
+    ++heap.destroyed;
+}
+
+static void Check_Starting_Army(int capacity, int allocation_limit, bool rgds)
+{
+    Heap heap(capacity);
+    int cursor = 0;
+    for (int i = 0; i < allocation_limit; ++i) {
+        Require(Reserve_Starting_Object(heap, cursor, rgds), "reserve an available slot");
+        Require(heap.Add(allocation_limit), "allocate the starting object");
+    }
+    Require(heap.destroyed == 0, "available slots must not evict objects");
+    Require(!heap.Add(allocation_limit), "allocator enforces the object limit");
+    for (int i = 0; i < capacity * 3; ++i) {
+        Require(Reserve_Starting_Object(heap, cursor, rgds), "reserve at the allocator limit");
+        Require(heap.Count() == allocation_limit - 1, "reservation frees exactly one slot");
+        Require(heap.Add(allocation_limit), "reservation must allow the subsequent allocation");
+    }
+    Require(heap.destroyed == capacity * 3, "round-robin reservation count");
+}
+
+int main()
+{
+    Check_Starting_Army(RGDS_GROUND_SAVE_CAPACITY, RGDS_GROUND_OBJECT_LIMIT, true);
+    Check_Starting_Army(500, 500, false);
+    Check_Starting_Army(17, 17, true);
+
+    Heap restored(RGDS_GROUND_SAVE_CAPACITY);
+    for (int i = 0; i < restored.Length(); ++i)
+        Require(restored.Add(restored.Length()), "restore a legacy slot");
+    const auto original = restored.objects;
+    int cursor = 0;
+    Require(!Reserve_Starting_Object(restored, cursor, true), "over-limit restored world rejects creation");
+    Require(restored.objects == original && restored.destroyed == 0, "legacy objects must be preserved");
+    Heap empty(0);
+    Require(!Reserve_Starting_Object(empty, cursor, true), "empty heap rejects creation");
+    std::puts("starting armies reserve at the allocation limit; legacy slots stay intact");
+}
