+protected:
+    int Action(unsigned flags, KeyNumType& key) override
+    {
+        if (RGDS_Video_Enabled() && (flags & KEYBOARD) && key == KN_RGDS_MENU) {
+            return false;
+        }
+        return EditClass::Action(flags, key);
+    }
+    void Draw_Text(const char* text) override
+    {
+        if (!RGDS_Video_Enabled()) {
+            EditClass::Draw_Text(text);
+            return;
+        }
+        std::string label = text ? text : "";
+        if (Has_Focus() && label.size() < size_t(MaxLength)) {
+            label += '_';
+        }
+        RGDS_Draw_Large_Text(label.c_str(), X + 8, Y + 4, Width - 16, Height - 8,
+                             Has_Focus() ? TPF_BRIGHT_COLOR : TPF_TEXT);
+    }
+};
+
+inline std::vector<std::string> RGDS_Wrap_Text(const char* text, int width)
+{
+    Fancy_Text_Print(TXT_NONE, 0, 0, GadgetClass::Get_Color_Scheme(), TBLACK, TPF_TEXT);
+    std::vector<std::string> lines;
+    std::string line;
+    auto flush = [&]() {
+        while (!line.empty() && line.back() == ' ') line.pop_back();
+        lines.push_back(line);
+        line.clear();
+    };
+    for (const char* p = text ? text : ""; *p; ++p) {
+        if (*p == '\r' || *p == '\n' || *p == '@') {
+            flush();
+            if (*p == '\r' && p[1] == '\n') ++p;
+            continue;
+        }
+        if (*p == 20) continue;
+        if (line.empty() && (*p == ' ' || *p == '\t')) continue;
+        line += *p == '\t' ? ' ' : *p;
+        if (String_Pixel_Width(line.c_str()) * 2 > width) {
+            size_t split = line.find_last_of(' ');
+            if (split == std::string::npos || split == 0) split = line.size() - 1;
+            std::string rest = line.substr(split);
+            line.resize(split);
+            flush();
+            const size_t first = rest.find_first_not_of(' ');
+            if (first != std::string::npos) line = rest.substr(first);
+        }
+    }
+    if (!line.empty() || lines.empty()) flush();
+    return lines;
+}
+
+inline int RGDS_Message_Box(const char* text, int caption, const char* first, const char* second,
+                             const char* third = nullptr, bool preserve = false, int cancel = -1,
+                             bool artwork = false)
+{
+    RGDSUIScope viewport;
+    const char* labels[3] = {first, second, third};
+    int count = 0;
+    while (count < 3 && labels[count] && *labels[count]) ++count;
+    if (cancel < 0) cancel = count > 1 ? 1 : 0;
+    const int width = 590;
+    const int text_top = caption == TXT_NONE ? 34 : 55;
+    const int max_lines = (386 - text_top - 21 - (count ? 34 : 0) - 34) / 26;
+    auto lines = RGDS_Wrap_Text(text, 480);
+    bool pages = int(lines.size()) > max_lines;
+    if (pages) lines = RGDS_Wrap_Text(text, 433);
+    const int shown_lines = std::min(max_lines, int(lines.size()));
+    const int body_height = std::max(pages ? 68 : 26, shown_lines * 26);
+    const int height = text_top + body_height + (count ? 21 + 34 : 0) + 34;
+    const int x = (SeenBuff.Get_Width() - width) / 2;
+    const int y = (SeenBuff.Get_Height() - height) / 2;
+    const int button_y = y + height - 68;
+    const int button_width = count ? (480 - (count - 1) * 13) / count : 480;
+    GraphicBufferClass background(SeenBuff.Get_Width(), SeenBuff.Get_Height());
+    if (preserve || artwork) SeenBuff.Blit(background);
+    RGDSTextButtonClass button1(1, first, TPF_BUTTON, x + 55, button_y, button_width, 34);
+    RGDSTextButtonClass button2(2, second, TPF_BUTTON, x + 55 + button_width + 13, button_y, button_width, 34);
+    RGDSTextButtonClass button3(3, third, TPF_BUTTON, x + 55 + 2 * (button_width + 13), button_y, button_width, 34);
+    RGDSTextButtonClass up(4, "Up", TPF_BUTTON, x + 501, y + text_top, 34, 34);
+    RGDSTextButtonClass down(5, "Dn", TPF_BUTTON, x + 501, y + text_top + body_height - 34, 34, 34);
+    if (count > 1) button2.Add_Tail(button1);
+    if (count > 2) button3.Add_Tail(button1);
+    if (pages && count) { up.Add_Tail(button1); down.Add_Tail(button1); }
+    int page = 0;
+    int selected = cancel;
+    int result = 0;
+    bool redraw = true;
+    Keyboard->Clear();
+    for (;;) {
+        if (redraw || AllSurfaces.SurfacesRestored) {
+            AllSurfaces.SurfacesRestored = false;
+            Set_Logic_Page(SeenBuff);
+            if (artwork) {
+                background.Blit(SeenBuff);
+            } else {
+                Dialog_Box(x, y, width, height);
+            }
+            if (caption != TXT_NONE) RGDS_Draw_Caption(caption, x, y, width);
+            for (int row = 0; row < shown_lines && page + row < int(lines.size()); ++row) {
+                RGDS_Draw_Large_Text(lines[page + row].c_str(), x + 55, y + text_top + row * 26,
+                                     pages ? 433 : 480, 26, TPF_TEXT);
+            }
+            if (count) {
+                button1.Turn_Off(); button2.Turn_Off(); button3.Turn_Off();
+                if (selected == 0) button1.Turn_On();
+                if (selected == 1) button2.Turn_On();
+                if (selected == 2) button3.Turn_On();
+                button1.Draw_All(true);
+            }
+            redraw = false;
+        }
+        if (!count) break;
+        Call_Back();
+        KeyNumType input = RGDS_Menu_Input(button1.Input());
+        if (input == KN_ESC) { result = cancel; break; }
+        if (input == KN_RETURN) { result = selected; break; }
+        if (input == KN_LEFT || input == KN_RIGHT) {
+            selected = (selected + count + (input == KN_LEFT ? -1 : 1)) % count;
+            redraw = true;
+        }
+        if (input == (4 | KN_BUTTON) || input == KN_UP) {
+            page = std::max(0, page - shown_lines); redraw = true;
+        }
+        if (input == (5 | KN_BUTTON) || input == KN_DOWN) {
+            if (page + shown_lines < int(lines.size())) page += shown_lines;
+            redraw = true;
+        }
+        if (input >= (1 | KN_BUTTON) && input <= (count | KN_BUTTON)) {
+            result = int(input & ~KN_BUTTON) - 1; break;
+        }
+        Frame_Limiter();
+    }
+    if (preserve) background.Blit(SeenBuff);
+    Keyboard->Clear();
+    return result;
+}
+
+#endif
diff --git a/redalert/rgds_view.cpp b/redalert/rgds_view.cpp
new file mode 100644
index 0000000..57a3772
--- /dev/null
+++ b/redalert/rgds_view.cpp
@@ -0,0 +1,109 @@
+#include "function.h"
+#include "rgds_view.h"
+#include "common/rgds_view.h"
+#include <algorithm>
+#include <cstdio>
+
+namespace {
+int menu_depth;
+int zoom_level = RGDS_ZOOM_DEFAULT;
+
+void Configure(bool gameplay)
+{
+    if (!RGDS_Video_Enabled()) return;
+    auto old = RGDS_View();
+    const int center_x = Coord_X(Map.TacticalCoord) + Map.TacLeptonWidth / 2;
+    const int center_y = Coord_Y(Map.TacticalCoord) + Map.TacLeptonHeight / 2;
+    if (!gameplay && old.active) {
+        // Preserve a map background for modal windows without changing the world image.
+        HidPage.Scale(HidPage, RGDS_WORLD_X, 0, 0, 0, old.world_w, old.world_h, 640, 480, false);
+        SeenBuff.Scale(SeenBuff, RGDS_WORLD_X, 0, 0, 0, old.world_w, old.world_h, 640, 480, false);
+    }
+    SeenBuff.Attach(&VisiblePage, 0, 0, gameplay ? RGDS_STAGE_W : 640, gameplay ? RGDS_STAGE_H : 480);
+    HidPage.Attach(&HiddenPage, 0, 0, gameplay ? RGDS_STAGE_W : 640, gameplay ? RGDS_STAGE_H : 480);
+    WindowList[WINDOW_MAIN][WINDOWWIDTH] = SeenBuff.Get_Width();
+    WindowList[WINDOW_MAIN][WINDOWHEIGHT] = SeenBuff.Get_Height();
+    int w, h;
+    RGDS_World_Size(zoom_level, Map.IsSidebarActive, w, h);
+    if (gameplay) Map.Set_Pixel_View(RGDS_WORLD_X, 0, w, h);
+    else Map.Set_Pixel_View(0, 0, 640, 480);
+    ++ScenarioInit;
+    Map.Set_Tactical_Position(XY_Coord(std::max(0, center_x - Map.TacLeptonWidth / 2),
+                                     std::max(0, center_y - Map.TacLeptonHeight / 2)));
+    --ScenarioInit;
+    RGDS_Set_Gameplay_View(gameplay, w, h, Map.IsSidebarActive, zoom_level);
+    Map.Flag_To_Redraw(true);
+    if (gameplay) std::fprintf(stderr, "RGDS world zoom=%d source=%dx%d sidebar=%d camera=%u,%u center=%d,%d\n",
+                              zoom_level, w, h, int(Map.IsSidebarActive), unsigned(Coord_X(Map.TacticalCoord)),
+                              unsigned(Coord_Y(Map.TacticalCoord)), center_x, center_y);
+}
+}
+
+void RGDS_Update_Gameplay_View()
+{
+    if (RGDS_Video_Enabled()) RGDS_Placement().Sync(Map.PendingObjectPtr);
+    if (!RGDS_Video_Enabled() || menu_depth) return;
+    const int request = RGDS_Take_Zoom_Request();
+    zoom_level = std::max(0, std::min(RGDS_ZOOM_LEVELS - 1, zoom_level + request));
+    const auto& view = RGDS_View();
+    if (view.active && view.level == zoom_level && Map.TacPixelX == RGDS_WORLD_X) {
+        if (view.sidebar != Map.IsSidebarActive) {
+            RGDS_Set_Gameplay_View(true, view.world_w, view.world_h, Map.IsSidebarActive, zoom_level);
+            Map.Flag_To_Redraw(true);
+            std::fprintf(stderr, "RGDS panel overlay=%d camera=%u,%u\n", int(Map.IsSidebarActive),
+                         unsigned(Coord_X(Map.TacticalCoord)), unsigned(Coord_Y(Map.TacticalCoord)));
+        }
+        return;
+    }
+    if (!view.active || view.level != zoom_level || view.sidebar != Map.IsSidebarActive
+        || Map.TacPixelX != RGDS_WORLD_X) Configure(true);
+}
+
+void RGDS_Reset_Gameplay_View()
+{
+    if (RGDS_Video_Enabled()) Configure(false);
+}
+
+void RGDS_Update_Squad_Badges()
+{
+    RGDS_Clear_Squad_Badges();
+    if (!RGDS_Video_Enabled() || !RGDS_View().active || !PlayerPtr) return;
+    auto collect = [](const ObjectClass* object) {
+        if (!object || !object->IsActive || !object->IsDown || object->IsInLimbo || !object->Is_Foot()) return;
+        const auto* unit = static_cast<const FootClass*>(object);
+        if (unit->Group >= 4 || unit->Strength <= 0
+            || (!unit->Is_Selected_By_Player() && Rule.ResourceBarDisplayMode != RulesClass::RB_ALWAYS)
+            || (!unit->House->Is_Ally(PlayerPtr) && !(unit->Spied_By() & (1 << PlayerPtr->Class->House)))) return;
+        int x, y, width, height;
+        if (!Map.Coord_To_Pixel(unit->Render_Coord(), x, y)) return;
+        unit->Class_Of().Dimensions(width, height);
+        // Match the native pips' infantry offset and aircraft altitude.
+        if (unit->What_Am_I() == RTTI_INFANTRY) { x -= 2; y -= 2; }
+        if (unit->What_Am_I() == RTTI_AIRCRAFT) y -= Lepton_To_Pixel(unit->Height);
+        RGDS_Add_Squad_Badge(unit->Group, x + 4 - width / 2,
+                            y + height / 2 - 8 - (unit->Class_Of().Max_Pips() ? 4 : 0));
+    };
+    if (Rule.ResourceBarDisplayMode == RulesClass::RB_ALWAYS) {
+        for (int i = 0; i < Units.Count(); ++i) collect(Units.Ptr(i));
+        for (int i = 0; i < Infantry.Count(); ++i) collect(Infantry.Ptr(i));
+        for (int i = 0; i < Aircraft.Count(); ++i) collect(Aircraft.Ptr(i));
+        for (int i = 0; i < Vessels.Count(); ++i) collect(Vessels.Ptr(i));
+    } else {
+        for (int i = 0; i < CurrentObject.Count(); ++i) collect(CurrentObject[i]);
+    }
+}
+
+RGDSUIScope::RGDSUIScope()
+{
+    if (!RGDS_Video_Enabled()) return;
+    RGDS_Placement().Reset();
+    restore = menu_depth++ == 0 && RGDS_View().active;
+    if (restore) Configure(false);
+}
+
+RGDSUIScope::~RGDSUIScope()
+{
+    if (!RGDS_Video_Enabled()) return;
+    --menu_depth;
+    if (restore && GameActive) Configure(true);
+}
