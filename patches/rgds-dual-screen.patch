+namespace {
+struct ConversionStatistics {
+    unsigned long long calls = 0, converted = 0, parallel = 0, verified = 0, pixels = 0;
+    int mode = 2;
+    bool verify = std::getenv("RED_ALERT_DS_PLUS_VERIFY_CONVERT") != nullptr;
+    bool report = std::getenv("RED_ALERT_DS_PLUS_CONVERT_STATS") != nullptr;
+    ConversionStatistics()
+    {
+        const char* value = std::getenv("RED_ALERT_DS_PLUS_CONVERT_MODE");
+        if (value && !std::strcmp(value, "legacy")) mode = 0;
+        else if (value && !std::strcmp(value, "serial")) mode = 1;
+    }
+    ~ConversionStatistics()
+    {
+        if (report) std::fprintf(stderr,
+            "PIXEL_CONVERT mode=%d calls=%llu converted=%llu parallel=%llu verified=%llu pixels=%llu\n",
+            mode, calls, converted, parallel, verified, pixels);
+    }
+};
+bool Convert_RGDS_Region(SDL_Surface* source, SDL_Surface* destination,
+                         const SDL_Rect& region, IndexedPaletteCache& cache)
+{
+    static ConversionStatistics stats;
+    ++stats.calls;
+    if (!stats.mode) return false;
+    const auto result = Convert_Indexed_Region(source, destination, region, cache, stats.mode == 2, stats.verify);
+    stats.converted += result.converted;
+    stats.parallel += result.parallel;
+    stats.verified += result.verified;
+    if (result.converted) stats.pixels += size_t(region.w) * region.h;
+    return result.converted;
+}
