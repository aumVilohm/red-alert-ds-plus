+    // Native score counters also credit captures.
+    for (int house = 0; house < HOUSE_COUNT; ++house) {
+        if (!PlayerPtr->Is_Ally(HousesType(house))) {
+            kills += PlayerPtr->UnitsKilled[house];
+            buildings += PlayerPtr->BuildingsKilled[house];
+        }
+    }
+    count("ENEMY KILLS", 209, kills);
+    count("BUILDING KILLS", 227, buildings);
+    count("UNIT LOSSES", 245, PlayerPtr->UnitsLost);
+    count("BUILDING LOSSES", 263, PlayerPtr->BuildingsLost);
+    count("HARVESTED", 289, PlayerPtr->HarvestedCredits);
+    count("SPENT", 307, PlayerPtr->CreditsSpent);
+    if (Scen.MissionTimer.Is_Active()) {
+        const int seconds = Scen.MissionTimer / TICKS_PER_SECOND;
+        char time[32];
+        snprintf(time, sizeof(time), "%02d:%02d", seconds / 60, seconds % 60);
+        metric("TIME LEFT", 335, time, color);
+    }
+    RGDS_Text_Block(statistics_page, status_page, RGDS_RADAR_SIZE + 13, 19, 224, 346);
+    const char* legend[][2] = {
+        {"TOUCH: SELECT/ORDER; DRAG: GROUP", "BUILD: TAP AGAIN TO CONFIRM"},
+        {"L1: BUILD   L2 / CORNER X: CANCEL", "START: MENU / RESUME"},
+        {"D-PAD: CAMERA   STICK: FAST CAMERA", "R1/R2: ZOOM   STICK CLICK: BASE"},
+        {"ABXY: CALL / ASSIGN FREE SLOT", "SELECT: CLEAR SQUAD SLOT"}};
+    static GraphicBufferClass legend_page(640, 160);
+    legend_page.Clear();
+    Set_Logic_Page(legend_page);
+    Simple_Text_Print(nullptr, 0, 0, color, TBLACK, style);
+    --FontXSpacing;
+    int left_width = 0;
+    for (const auto& row : legend) {
+        left_width = std::max(left_width, int(String_Pixel_Width(row[0])));
+    }
+    ++FontXSpacing;
+    const int row_step = FontHeight + 1;
+    for (int row = 0; row < 4; ++row) {
+        text(legend[row][0], 0, row * row_step, color);
+        text(legend[row][1], left_width + 21, row * row_step, color);
+    }
+    RGDS_Text_Block(legend_page, status_page, 13, RGDS_RADAR_SIZE + 8, 614, 74);
+    Set_Logic_Page(oldpage);
+    RGDS_Update_Status(status_page.Get_Buffer(), 1024, 1024, 768, true);
+}
