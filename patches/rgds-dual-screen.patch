+#include <vector>
 
 constexpr int xor_bytes_needed(int bytes)
 {
@@ -45,11 +46,43 @@ int test_xordelta()
     return ret;
 }
 
+int test_xordelta_boundaries()
+{
+    const int lengths[] = {1, 2, 3, 4, 127, 128, 255, 256, 16383, 16384, 32767, 32768};
+    for (int length : lengths) {
+        for (int pattern = 0; pattern < 5; ++pattern) {
+            std::vector<uint8_t> base(length, 0x55);
+            std::vector<uint8_t> source(base);
+            if (pattern == 1) {
+                memset(source.data(), 0xAA, length);
+            } else if (pattern == 2) {
+                for (int i = 0; i < length; ++i) {
+                    source[i] ^= static_cast<uint8_t>(i % 2 + 1);
+                }
+            } else if (pattern == 3) {
+                source.back() ^= 1;
+            } else if (pattern == 4) {
+                memset(source.data(), 0xAA, length);
+                source.back() = base.back();
+            }
+            std::vector<uint8_t> delta(xor_bytes_needed(length));
+            Generate_XOR_Delta(delta.data(), source.data(), base.data(), length);
+            Apply_XOR_Delta(base.data(), delta.data());
+            if (base != source) {
+                fprintf(stderr, "XOR delta boundary round trip failed: length=%d pattern=%d\n", length, pattern);
+                return 1;
+            }
+        }
+    }
+    return 0;
+}
+
 int main(int argc, char** argv)
 {
     int ret = 0;
 
     ret |= test_xordelta();
+    ret |= test_xordelta_boundaries();
 
     return ret;
 }
diff --git a/common/indexed_blit.cpp b/common/indexed_blit.cpp
new file mode 100644
index 0000000..ee77363
--- /dev/null
+++ b/common/indexed_blit.cpp
@@ -0,0 +1,113 @@
+#include "indexed_blit.h"
+#include "parallel_scan.h"
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+struct Rows {
+    const Uint8* source;
+    Uint8* destination;
+    const Uint32* colors;
+    int width, source_pitch, destination_pitch;
+};
+void Convert_Rows(void* context, int begin, int end, int)
+{
+    const Rows& rows = *static_cast<Rows*>(context);
+    const int width = rows.width, source_pitch = rows.source_pitch, destination_pitch = rows.destination_pitch;
+    const Uint32* colors = rows.colors;
+    const Uint8* input = rows.source;
+    Uint8* output = rows.destination;
+    for (int y = begin; y < end; ++y) {
+        const Uint8* source = input + y * source_pitch;
+        Uint32* destination = reinterpret_cast<Uint32*>(output + y * destination_pitch);
+        int remaining = width;
+        while (remaining >= 4) {
+            const Uint32 a = colors[source[0]], b = colors[source[1]];
+            const Uint32 c = colors[source[2]], d = colors[source[3]];
+            destination[0] = a; destination[1] = b;
+            destination[2] = c; destination[3] = d;
+            source += 4; destination += 4; remaining -= 4;
+        }
+        while (remaining-- > 0) *destination++ = colors[*source++];
+    }
+}
+bool Contains(SDL_Surface* surface, const SDL_Rect& region)
+{
+    return region.x >= 0 && region.y >= 0 && region.w > 0 && region.h > 0
+        && region.x <= surface->w && region.w <= surface->w - region.x
+        && region.y <= surface->h && region.h <= surface->h - region.y
+        && surface->clip_rect.x == 0 && surface->clip_rect.y == 0
+        && surface->clip_rect.w == surface->w && surface->clip_rect.h == surface->h;
+}
+}
+
+IndexedBlitResult Convert_Indexed_Region(SDL_Surface* source, SDL_Surface* destination,
+    const SDL_Rect& region, IndexedPaletteCache& cache, bool parallel, bool verify)
+{
+    IndexedBlitResult result;
+    SDL_BlendMode blend;
+    Uint8 red, green, blue, alpha;
+    if (!source || !destination || source->format->BytesPerPixel != 1
+        || !source->format->palette || source->format->palette->ncolors != 256
+        || destination->format->BytesPerPixel != 4 || destination->format->BitsPerPixel != 32
+        || SDL_MUSTLOCK(source) || SDL_MUSTLOCK(destination) || SDL_HasColorKey(source)
+        || !Contains(source, region) || !Contains(destination, region)
+        || destination->pitch % sizeof(Uint32) != 0
+        || reinterpret_cast<uintptr_t>(destination->pixels) % alignof(Uint32) != 0
+        || SDL_GetSurfaceBlendMode(source, &blend) != 0 || blend != SDL_BLENDMODE_NONE
+        || SDL_GetSurfaceColorMod(source, &red, &green, &blue) != 0
+        || red != 255 || green != 255 || blue != 255
+        || SDL_GetSurfaceAlphaMod(source, &alpha) != 0 || alpha != 255) return result;
+    const uintptr_t source_begin = reinterpret_cast<uintptr_t>(source->pixels);
+    const uintptr_t destination_begin = reinterpret_cast<uintptr_t>(destination->pixels);
+    const uintptr_t source_end = source_begin + size_t(source->h) * source->pitch;
+    const uintptr_t destination_end = destination_begin + size_t(destination->h) * destination->pitch;
+    if (source_begin < destination_end && destination_begin < source_end) return result;
+    const uintptr_t cache_begin = reinterpret_cast<uintptr_t>(&cache), cache_end = cache_begin + sizeof(cache);
+    if ((source_begin < cache_end && cache_begin < source_end)
+        || (destination_begin < cache_end && cache_begin < destination_end)) return result;
+
+    const SDL_Palette* palette = source->format->palette;
+    if (cache.palette != palette || cache.version != palette->version || cache.format != destination->format->format) {
+        for (int i = 0; i < 256; ++i) {
+            const SDL_Color& color = palette->colors[i];
+            cache.colors[i] = SDL_MapRGBA(destination->format, color.r, color.g, color.b, color.a);
+        }
+        cache.palette = palette;
+        cache.version = palette->version;
+        cache.format = destination->format->format;
+    }
+    SDL_Surface* reference = nullptr;
+    if (verify) {
+        reference = SDL_CreateRGBSurfaceWithFormat(0, region.w, region.h, 32, destination->format->format);
+        SDL_Rect src = region;
+        if (!reference || SDL_BlitSurface(source, &src, reference, nullptr) != 0) std::abort();
+    }
+    Rows rows;
+    rows.source = static_cast<const Uint8*>(source->pixels) + region.y * source->pitch + region.x;
+    rows.destination = static_cast<Uint8*>(destination->pixels) + region.y * destination->pitch + region.x * 4;
+    rows.colors = cache.colors;
+    rows.width = region.w;
+    rows.source_pitch = source->pitch;
+    rows.destination_pitch = destination->pitch;
+    // The caller owns both surfaces and their palette until this phase returns.
+    // Workers touch only distinct output rows and never call SDL.
+    ParallelScan* pool = parallel && size_t(region.w) * region.h >= 131072 ? Shared_Parallel_Scan() : nullptr;
+    if (pool) { pool->Run(region.h, Convert_Rows, &rows); result.parallel = true; }
+    else Convert_Rows(&rows, 0, region.h, 0);
+    if (reference) {
+        for (int y = 0; y < region.h; ++y) {
+            if (std::memcmp(rows.destination + y * rows.destination_pitch,
+                            static_cast<const Uint8*>(reference->pixels) + y * reference->pitch, region.w * 4)) {
+                std::fprintf(stderr, "Indexed conversion mismatch at row %d of %dx%d\n", y, region.w, region.h);
+                std::abort();
+            }
+        }
+        SDL_FreeSurface(reference);
+        result.verified = true;
+    }
+    result.converted = true;
+    return result;
+}
