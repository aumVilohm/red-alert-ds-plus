+        Set_Video_Mouse(RGDS_WORLD_X + RGDS_View().world_w / 2, RGDS_View().world_h / 2);
+    }
+}
+
+bool RGDS_Cancel_Pointer(uint32_t id, int x, int y, int& game_x, int& game_y)
+{
+    if (!RGDS_View().active || rgds_movie_mode || !Is_Game_Video_Window(id)) return false;
+    int ww, wh;
+    SDL_GetWindowSize(window, &ww, &wh);
+    if (ww <= 0 || wh <= 0 || !RGDS_Cancel_Hit(x * 1024 / ww, y * 768 / wh)) return false;
+    // Cancel through the tactical gadget, even when the corner overlays the sidebar.
+    game_x = RGDS_WORLD_X + RGDS_View().world_w / 2;
+    game_y = RGDS_View().world_h / 2;
+    return true;
+}
+
+void Set_Video_Mouse(int game_x, int game_y)
+{
+    hwcursor.X = std::max(0, std::min(hwcursor.GameW - 1, game_x));
+    hwcursor.Y = std::max(0, std::min(hwcursor.GameH - 1, game_y));
+}
