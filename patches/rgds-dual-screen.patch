diff --git a/common/parallel_scan.h b/common/parallel_scan.h
new file mode 100644
index 0000000..7db1ff7
--- /dev/null
+++ b/common/parallel_scan.h
@@ -0,0 +1,99 @@
+#ifndef PARALLEL_SCAN_H
+#define PARALLEL_SCAN_H
+
+#include <condition_variable>
+#include <mutex>
+#include <memory>
+#include <system_error>
+#include <thread>
+
+// One caller lends a read-only range until every lane has finished. No work
+// survives Run(), so the caller can then modify or destroy its input safely.
+// Run requires a single, non-reentrant caller and a callback that never throws.
+// The count must be nonnegative and at most INT_MAX / 3; destruction must not
+// overlap Run(). Current callers keep simulation and rendering on one thread.
+class ParallelScan
+{
+public:
+    typedef void (*Function)(void*, int, int, int);
+
+    ParallelScan()
+    {
+        try {
+            for (int i = 0; i < 2; ++i) workers[i] = std::thread(&ParallelScan::Worker, this, i + 1);
+        } catch (...) {
+            Stop();
+            throw;
+        }
+    }
+    ~ParallelScan() { Stop(); }
+    ParallelScan(const ParallelScan&) = delete;
+    ParallelScan& operator=(const ParallelScan&) = delete;
+
+    void Run(int count, Function function, void* context)
+    {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            size = count;
+            callback = function;
+            data = context;
+            remaining = 2;
+            ++generation;
+        }
+        ready.notify_all();
+        function(context, 0, count / 3, 0);
+        std::unique_lock<std::mutex> lock(mutex);
+        done.wait(lock, [this] { return remaining == 0; });
+        callback = nullptr;
+        data = nullptr;
+    }
+
+private:
+    void Worker(int lane)
+    {
+        unsigned seen = 0;
+        std::unique_lock<std::mutex> lock(mutex);
+        for (;;) {
+            ready.wait(lock, [this, seen] { return stopping || generation != seen; });
+            if (stopping) return;
+            seen = generation;
+            const int begin = size * lane / 3, end = size * (lane + 1) / 3;
+            Function function = callback;
+            void* context = data;
+            lock.unlock();
+            function(context, begin, end, lane);
+            lock.lock();
+            if (--remaining == 0) done.notify_one();
+        }
+    }
+    void Stop()
+    {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stopping = true;
+        }
+        ready.notify_all();
+        for (auto& worker : workers) if (worker.joinable()) worker.join();
+    }
+
+    std::mutex mutex;
+    std::condition_variable ready, done;
+    std::thread workers[2];
+    Function callback = nullptr;
+    void* data = nullptr;
+    int size = 0, remaining = 0;
+    unsigned generation = 0;
+    bool stopping = false;
+};
+
+// Both simulation scans and pixel conversion borrow the same two workers.
+inline ParallelScan* Shared_Parallel_Scan()
+{
+    static std::unique_ptr<ParallelScan> pool = [] {
+        try { return std::unique_ptr<ParallelScan>(new ParallelScan); }
+        catch (const std::system_error&) { return std::unique_ptr<ParallelScan>(); }
+    }();
+    return pool.get();
+}
+
+#endif
diff --git a/common/rgds_layout.h b/common/rgds_layout.h
new file mode 100644
index 0000000..ccd2c50
--- /dev/null
+++ b/common/rgds_layout.h
@@ -0,0 +1,29 @@
+#ifndef RGDS_LAYOUT_H
+#define RGDS_LAYOUT_H
+
+#include <algorithm>
+#include <cstdint>
+
+// Window coordinates and renderer pixels can differ on high density displays.
+inline bool RGDS_Map_Point(int x, int y, int window_w, int window_h, int output_w, int output_h,
+                           int viewport_x, int viewport_y, int viewport_w, int viewport_h,
+                           int game_w, int game_h, int& gx, int& gy, bool clamp)
+{
+    if (window_w <= 0 || window_h <= 0 || output_w <= 0 || output_h <= 0
+        || viewport_w <= 0 || viewport_h <= 0 || game_w <= 0 || game_h <= 0) {
+        return false;
+    }
+    if (!clamp && (x < 0 || y < 0 || x >= window_w || y >= window_h)) {
+        return false;
+    }
+    const int64_t px = int64_t(x) * output_w / window_w - viewport_x;
+    const int64_t py = int64_t(y) * output_h / window_h - viewport_y;
+    if (!clamp && (px < 0 || py < 0 || px >= viewport_w || py >= viewport_h)) {
+        return false;
+    }
+    gx = int(std::max<int64_t>(0, std::min<int64_t>(game_w - 1, px * game_w / viewport_w)));
+    gy = int(std::max<int64_t>(0, std::min<int64_t>(game_h - 1, py * game_h / viewport_h)));
+    return true;
+}
+
+#endif
diff --git a/common/rgds_view.h b/common/rgds_view.h
new file mode 100644
index 0000000..b789972
--- /dev/null
+++ b/common/rgds_view.h
@@ -0,0 +1,106 @@
+#ifndef RGDS_VIEW_H
+#define RGDS_VIEW_H
+
+#include <algorithm>
+
+// The UI and world occupy separate regions of the indexed staging surface.
+constexpr int RGDS_UI_W = 640;
+constexpr int RGDS_UI_H = 480;
+constexpr int RGDS_RADAR_SIZE = 384;
+constexpr int RGDS_RADAR_BORDER = 6;
+constexpr int RGDS_WORLD_X = 640;
+constexpr int RGDS_STAGE_W = 1920;
+constexpr int RGDS_STAGE_H = 960;
+constexpr int RGDS_ZOOM_LEVELS = 5;
+constexpr int RGDS_ZOOM_DEFAULT = 2;
+constexpr int RGDS_CANCEL_RADIUS = 110;
+constexpr int RGDS_PANEL_W = 336;
+constexpr int RGDS_PANEL_SRC_X = 492;
+constexpr int RGDS_PANEL_SRC_Y = 0;
+constexpr int RGDS_PANEL_SRC_W = 147;
+constexpr int RGDS_PANEL_SRC_H = 336;
+constexpr int RGDS_PANEL_ROWS = 5;
+constexpr int RGDS_CARD_Y = 40;
+constexpr int RGDS_LABEL_SCALE = 2;
+
+struct RGDSViewState {
+    bool active = false;
+    bool sidebar = false;
+    int level = RGDS_ZOOM_DEFAULT;
+    int world_w = 640;
+    int world_h = 480;
+};
+
+inline RGDSViewState& RGDS_View()
+{
+    static RGDSViewState state;
+    return state;
+}
+
+inline void RGDS_World_Size(int level, bool sidebar, int& w, int& h)
+{
+    const int widths[] = {384, 512, 640, 1024, 1280};
+    const int heights[] = {288, 384, 480, 768, 960};
+    level = std::max(0, std::min(RGDS_ZOOM_LEVELS - 1, level));
+    w = widths[level];
+    h = heights[level];
+}
+
+inline bool RGDS_Cancel_Hit(int x, int y)
+{
+    if (x < 1024 - RGDS_CANCEL_RADIUS || y < 768 - RGDS_CANCEL_RADIUS || x >= 1024 || y >= 768)
+        return false;
+    const int dx = 1023 - x, dy = 767 - y;
+    return dx * dx + dy * dy < RGDS_CANCEL_RADIUS * RGDS_CANCEL_RADIUS;
+}
+
+// Physical coordinates use a 1024x768 composition independently of world zoom.
+inline bool RGDS_Project_Point(const RGDSViewState& view, int x, int y, int& gx, int& gy)
+{
+    if (x < 0 || y < 0 || x >= 1024 || y >= 768) return false;
+    if (view.active && RGDS_Cancel_Hit(x, y)) return false;
+    if (view.sidebar && x < RGDS_PANEL_W) {
+        gx = RGDS_PANEL_SRC_X + x * RGDS_PANEL_SRC_W / RGDS_PANEL_W;
+        gy = RGDS_PANEL_SRC_Y + y * RGDS_PANEL_SRC_H / 768;
+    } else {
+        gx = RGDS_WORLD_X + x * view.world_w / 1024;
+        gy = y * view.world_h / 768;
+    }
+    return true;
+}
+
+// Placement requires a second stationary press at the cell selected by the first gesture.
+struct RGDSPlacementState {
+    const void* object = nullptr;
+    int armed_cell = -1;
+    int pressed_cell = -1;
+    bool confirm = false;
+    bool submitted = false;
+    bool dragged = false;
+    int pointer_x = 0, pointer_y = 0;
+
+    void Reset() { object = nullptr; armed_cell = pressed_cell = -1; confirm = submitted = dragged = false; }
+    void Sync(const void* current) { if (object != current) { Reset(); object = current; } }
+    void Begin_Pointer(int x, int y) { pointer_x = x; pointer_y = y; dragged = false; }
+    void Move_Pointer(int x, int y) {
+        if (x > pointer_x + 8 || x < pointer_x - 8 || y > pointer_y + 8 || y < pointer_y - 8)
+            dragged = true;
+    }
+    void Press(int cell) { pressed_cell = cell; confirm = !submitted && armed_cell == cell; }
+    void Move(int cell) { if (cell != pressed_cell) confirm = false; }
+    bool Release(int cell) {
+        const bool place = !submitted && !dragged && confirm && pressed_cell == cell && armed_cell == cell;
+        pressed_cell = -1;
+        confirm = false;
+        if (!submitted) armed_cell = cell;
+        return place;
+    }
+};
+
+inline RGDSPlacementState& RGDS_Placement()
+{
+    static RGDSPlacementState state;
+    return state;
+}
+
+#endif
diff --git a/redalert/rgds_detach.cpp b/redalert/rgds_detach.cpp
new file mode 100644
index 0000000..4978dbb
--- /dev/null
+++ b/redalert/rgds_detach.cpp
@@ -0,0 +1,116 @@
+#include "rgds_detach.h"
+#include "rgds_workers.h"
+
+#ifdef RED_ALERT_DS_PLUS
+#include "function.h"
+#include "common/parallel_scan.h"
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+const int Capacity = 2048;
+struct Statistics {
+    uint64_t jobs = 0, parallel = 0, fallback = 0, objects = 0, applied = 0, skipped = 0, checked = 0;
+    int mode = 2;
+    bool verify = std::getenv("RED_ALERT_DS_PLUS_VERIFY_DETACH") != nullptr;
+    bool report = std::getenv("RED_ALERT_DS_PLUS_DETACH_STATS") != nullptr;
+    Statistics()
+    {
+        const char* value = std::getenv("RED_ALERT_DS_PLUS_DETACH_MODE");
+        if (value && !std::strcmp(value, "legacy")) mode = 0;
+        else if (value && !std::strcmp(value, "serial")) mode = 1;
+    }
+    ~Statistics()
+    {
+        if (report) std::fprintf(stderr,
+            "DETACH_SCAN mode=%d jobs=%llu parallel=%llu fallback=%llu objects=%llu applied=%llu skipped=%llu checked=%llu frame=%d\n",
+            mode, (unsigned long long)jobs, (unsigned long long)parallel, (unsigned long long)fallback,
+            (unsigned long long)objects, (unsigned long long)applied, (unsigned long long)skipped,
+            (unsigned long long)checked, Frame);
+    }
+};
+Statistics& Stats() { static Statistics value; return value; }
+
+// Radio callbacks and restoring a suspended mission can affect other objects.
+// Such a heap uses the original sweep, without applying any cached decisions.
+unsigned char Classify(const FootClass* object, TARGET target)
+{
+    if (object->In_Radio_Contact() || object->Trigger.Is_Valid() || object->SuspendedMission != MISSION_NONE)
+        return 2;
+    bool match = object->TarCom == target || object->SuspendedTarCom == target
+        || object->NavCom == target || object->SuspendedNavCom == target || object->ArchiveTarget == target;
+    for (int i = 0; i < ARRAY_SIZE(object->NavQueue); ++i) match |= object->NavQueue[i] == target;
+    return match ? 1 : 0;
+}
+
+template<class Heap> struct Scan {
+    Heap* heap;
+    TARGET target;
+    unsigned char flags[Capacity];
+};
+template<class Heap> void Classify_Range(void* data, int begin, int end, int)
+{
+    Scan<Heap>& scan = *static_cast<Scan<Heap>*>(data);
+    for (int i = begin; i < end; ++i) scan.flags[i] = Classify(scan.heap->Ptr(i), scan.target);
+}
+
+template<class Heap> bool Detach(Heap& heap, TARGET target, bool all)
+{
+    if (!RGDS_Video_Enabled()) return false;
+    Statistics& stats = Stats();
+    const int count = heap.Count();
+    if (!stats.mode || count < 256 || count > Capacity) return false;
+    Scan<Heap> scan;
+    scan.heap = &heap;
+    scan.target = target;
+    ParallelScan* pool = stats.mode == 2 && count >= 768 ? RGDS_Workers() : nullptr;
+    if (pool) { pool->Run(count, Classify_Range<Heap>, &scan); ++stats.parallel; }
+    else Classify_Range<Heap>(&scan, 0, count, 0);
+    ++stats.jobs;
+    stats.objects += count;
+    for (int i = 0; i < count; ++i) {
+        if (scan.flags[i] == 2) { ++stats.fallback; return false; }
+    }
+    // Only reference-free objects are skipped. All mutations, including overlap
+    // marks, retain the original heap order and execute on the caller thread.
+    for (int i = 0; i < count; ++i) {
+        auto* object = heap.Ptr(i);
+        if (stats.verify && (heap.Count() != count || Classify(object, target) != scan.flags[i])) std::abort();
+        if (scan.flags[i]) { object->Detach(target, all); ++stats.applied; }
+        else {
+            ++stats.skipped;
+            if (stats.verify) {
+                unsigned char before[sizeof(*object)];
+                std::memcpy(before, object, sizeof(before));
+                object->Detach(target, all);
+                if (std::memcmp(before, object, sizeof(before))) {
+                    std::fprintf(stderr, "Detach skip mismatch at frame %d index %d\n", Frame, i);
+                    std::abort();
+                }
+                ++stats.checked;
+            }
+        }
+    }
+    return true;
+}
+}
+#endif
+
+bool RGDS_Detach_Units(int target, bool all)
+{
+#ifdef RED_ALERT_DS_PLUS
+    return Detach(Units, target, all);
+#else
+    return false;
+#endif
+}
+bool RGDS_Detach_Infantry(int target, bool all)
+{
+#ifdef RED_ALERT_DS_PLUS
+    return Detach(Infantry, target, all);
+#else
+    return false;
+#endif
+}
