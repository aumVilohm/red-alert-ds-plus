+bool WWKeyboardClassSDL2::Put_Pointer_Button(unsigned short key, int x, int y, bool release, unsigned char source)
+{
+    unsigned char& sources = PointerSources[key - 1];
+    const unsigned char updated = release ? sources & ~source : sources | source;
+    if ((sources == 0) != (updated == 0) && !Put_Mouse_Message(key, x, y, updated == 0)) {
+        PointerQueueBlocked = true;
+        return false;
+    }
+    sources = updated;
+    return true;
+}
+
+void WWKeyboardClassSDL2::Handle_Touch_Event(const SDL_TouchFingerEvent& finger)
+{
+    if (finger.touchId == SDL_MOUSE_TOUCHID) {
+        return;
+    }
+    const bool press = finger.type == SDL_FINGERDOWN;
+    const bool release = finger.type == SDL_FINGERUP;
+    if (press ? TouchActive : (!TouchActive || finger.touchId != ActiveTouch || finger.fingerId != ActiveFinger)) {
+        return;
+    }
+
+    const uint32_t windowId = press ? finger.windowID : TouchWindow;
+    SDL_Window* touchWindow = SDL_GetWindowFromID(windowId);
+    if (touchWindow == nullptr || !Is_Game_Video_Window(windowId)) {
+        return;
+    }
+    int width, height, x, y;
+    SDL_GetWindowSize(touchWindow, &width, &height);
+    if (width <= 0 || height <= 0) {
+        return;
+    }
+    const int px = std::min(width - 1, static_cast<int>(std::max(0.0f, std::min(finger.x, 1.0f)) * width));
+    const int py = std::min(height - 1, static_cast<int>(std::max(0.0f, std::min(finger.y, 1.0f)) * height));
+    if (!press) RGDS_Placement().Move_Pointer(px, py);
+    if (TouchCancel && !press) {
+        Get_Video_Mouse(x, y);
+        if (release && Put_Pointer_Button(VK_RBUTTON, x, y, true, 2)) TouchActive = TouchCancel = false;
+        return;
+    }
+    if (press && RGDS_Cancel_Pointer(windowId, px, py, x, y)) {
+        Set_Video_Mouse(x, y);
+        if (Put_Pointer_Button(VK_RBUTTON, x, y, false, 2)) {
+            TouchActive = TouchCancel = true;
+            ActiveTouch = finger.touchId;
+            ActiveFinger = finger.fingerId;
+            TouchWindow = windowId;
+        }
+        return;
+    }
+    if (!Map_Video_Mouse(windowId, px, py, x, y, !press)) {
+        if (!release) return;
+        // Finish a world drag at its last valid point rather than through the overlay.
+        Get_Video_Mouse(x, y);
+    }
+    Set_Video_Mouse(x, y);
+    if (press) {
+        if (Put_Pointer_Button(VK_LBUTTON, x, y, false, 2)) {
+            RGDS_Placement().Begin_Pointer(px, py);
+            TouchActive = true;
+            ActiveTouch = finger.touchId;
+            ActiveFinger = finger.fingerId;
+            TouchWindow = windowId;
+        }
+    } else if (release && Put_Pointer_Button(VK_LBUTTON, x, y, true, 2)) {
+        TouchActive = false;
+    }
+}
+
+void WWKeyboardClassSDL2::Release_RGDS_Input()
+{
+    InputReleasePending = false;
+    int x, y;
+    Get_Video_Mouse(x, y);
+    for (unsigned short key = VK_LBUTTON; key <= VK_MBUTTON; ++key) {
+        if (!Put_Pointer_Button(key, x, y, true, 7)) {
+            InputReleasePending = true;
+        }
+    }
+    for (unsigned short key = 4; key < SDL_NUM_SCANCODES; ++key) {
+        if (Down(key)) {
+            if (!Put_Key_Message(key, true)) {
+                InputReleasePending = true;
+            }
+        }
+    }
+    TouchActive = TouchCancel = MouseCancel = false;
+    RGDS_Placement().Reset();
+    ControllerLeftXAxis = ControllerLeftYAxis = 0;
+    ControllerRightXAxis = ControllerRightYAxis = 0;
+    AnalogScrollActive = false;
+    ScrollDirection = SDIR_NONE;
+    ControllerSpeedBoost = 1;
+    LeftTriggerDown = false;
+    RightTriggerDown = false;
+    LastControllerTime = SDL_GetTicks();
+}
