+static void Refresh_RGDS_Viewport()
+{
+    static int last_w = -1;
+    static int last_h = -1;
+    int w, h;
+    if (RGDS_Video_Enabled() && renderer && SDL_GetRendererOutputSize(renderer, &w, &h) == 0
+        && (w != last_w || h != last_h)) {
+        last_w = w;
+        last_h = h;
+        Update_HWCursor_Settings();
+    }
+}
