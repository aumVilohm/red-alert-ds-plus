+// Decode one silent offscreen frame. The caller supplies the playback clock.
+VQAErrorType VQA_DecodeFrame(VQAHandle* handle)
+{
+    VQAData* data = handle->VQABuf;
+    if (!data || (handle->Config.OptionFlags & VQAOPTF_AUDIO)
+        || !(handle->Config.OptionFlags & VQAOPTF_SINGLESTEP)) {
+        return VQAERR_ERROR;
+    }
+    if (!(data->Flags & VQA_DATA_FLAG_32)) {
+        VQA_ConfigureDrawer(handle);
+        data->Flags |= VQA_DATA_FLAG_32;
+    }
+    if (data->DrawnFrames >= handle->Header.Frames) {
+        return VQAERR_ERROR;
+    }
+    // Load once, then draw from the primed ring even after the stream reaches its end.
+    const int loaded = VQA_LoadFrame(handle);
+    if (loaded == VQAERR_NONE) {
+        ++data->LoadedFrames;
+    } else if (loaded != VQAERR_NOBUFFER && data->Loader.CurFrameNum < handle->Header.Frames) {
+        return VQAERR_ERROR;
+    }
+    const auto result = static_cast<VQAErrorType>(data->Draw_Frame(handle));
+    if (result != VQAERR_NONE) {
+        return result;
+    }
+    ++data->DrawnFrames;
+    return VQA_UserUpdate(handle);
+}
