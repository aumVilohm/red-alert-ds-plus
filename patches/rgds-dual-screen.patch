+inline void RGDS_Draw_Large_Text(const char* text, int x, int y, int width, int height,
+                                 TextPrintType flags, bool centered = false)
+{
+    if (!text || !*text || width <= 0 || height <= 0) {
+        return;
+    }
+    static GraphicBufferClass label(512, 32);
+    auto* scheme = GadgetClass::Get_Color_Scheme();
+    GraphicViewPortClass* oldpage = Set_Logic_Page(label);
+    label.Clear();
+    Simple_Text_Print(text, 0, 0, scheme, TBLACK, TPF_TEXT | flags);
+    const int w = std::min(int(String_Pixel_Width(text)), label.Get_Width());
+    const int h = std::min(int(FontHeight), label.Get_Height());
+    int first = h, last = -1;
+    const auto* pixels = static_cast<const unsigned char*>(label.Get_Buffer());
+    for (int yy = 0; yy < h; ++yy) {
+        for (int xx = 0; xx < w; ++xx) {
+            if (pixels[yy * label.Get_Width() + xx]) {
+                first = std::min(first, yy);
+                last = yy;
+            }
+        }
+    }
+    Set_Logic_Page(oldpage);
+    if (w > 0 && last >= first) {
+        // Center the visible glyphs, keeping their proportions inside the available area.
+        const int ink_height = last - first + 1;
+        int dw = std::min(width, w * 2);
+        int dh = ink_height * dw / w;
+        if (dh > height) {
+            dh = height;
+            dw = w * dh / ink_height;
+        }
+        const int dx = x + (centered ? (width - dw) / 2 : 0);
+        const int dy = y + (height - dh) / 2;
+        if (RGDS_Artwork_Text_Ink() >= 0) {
+            auto* ink = static_cast<unsigned char*>(label.Get_Buffer());
+            for (int yy = first; yy <= last; ++yy) {
+                for (int xx = 0; xx < w; ++xx) {
+                    if (ink[yy * label.Get_Width() + xx])
+                        ink[yy * label.Get_Width() + xx] = RGDS_Artwork_Text_Shadow();
+                }
+            }
+            label.Scale(*LogicPage, 0, first, dx + 1, dy + 1, w, ink_height, dw, dh, true);
+            for (int yy = first; yy <= last; ++yy) {
+                for (int xx = 0; xx < w; ++xx) {
+                    if (ink[yy * label.Get_Width() + xx])
+                        ink[yy * label.Get_Width() + xx] = RGDS_Artwork_Text_Ink();
+                }
+            }
+        }
+        label.Scale(*LogicPage, 0, first, dx, dy,
+                    w, ink_height, dw, dh, true);
+    }
+}
