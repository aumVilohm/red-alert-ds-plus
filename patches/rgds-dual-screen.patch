diff --git a/redalert/rgds_limits.h b/redalert/rgds_limits.h
new file mode 100644
index 0000000..ce147fa
--- /dev/null
+++ b/redalert/rgds_limits.h
@@ -0,0 +1,22 @@
+#ifndef RA_RGDS_LIMITS_H
+#define RA_RGDS_LIMITS_H
+
+constexpr int RGDS_GROUND_OBJECT_LIMIT = 700;
+// Older saves can reference slots above the limit for newly created objects.
+constexpr int RGDS_GROUND_SAVE_CAPACITY = 1000;
+
+template <class Heap> bool Reserve_Starting_Object(Heap& heap, int& index, bool rgds)
+{
+    const int limit = rgds && heap.Length() > RGDS_GROUND_OBJECT_LIMIT
+        ? RGDS_GROUND_OBJECT_LIMIT : heap.Length();
+    const int count = heap.Count();
+    if (count < limit) return true;
+    // A restored world above the new limit keeps its existing objects.
+    if (limit <= 0 || count > limit) return false;
+    index %= count;
+    delete heap.Ptr(index);
+    index = (index + 1) % limit;
+    return heap.Count() < limit;
+}
+
+#endif
diff --git a/redalert/rgds_target_scan.cpp b/redalert/rgds_target_scan.cpp
new file mode 100644
index 0000000..5ab4a93
--- /dev/null
+++ b/redalert/rgds_target_scan.cpp
@@ -0,0 +1,119 @@
+#include "rgds_target_scan.h"
+#include "rgds_workers.h"
+
+#ifdef RED_ALERT_DS_PLUS
+#include "function.h"
+#include "common/parallel_scan.h"
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <system_error>
+#include <cstdint>
+
+namespace {
+struct alignas(64) Result {
+    const ObjectClass* object = nullptr;
+    int value = -1;
+};
+struct Scan {
+    const TechnoClass* source;
+    ThreatType method;
+    int mask, zone;
+    Result result[3];
+};
+
+void Evaluate(void* data, int begin, int end, int lane)
+{
+    Scan& scan = *static_cast<Scan*>(data);
+    Result& result = scan.result[lane];
+    for (int index = begin; index < end; ++index) {
+        const ObjectClass* object = Map.Layer[LAYER_GROUND][index];
+        int value = 0;
+        if (object->Is_Techno()
+            && scan.source->Evaluate_Object(scan.method, scan.mask, -1,
+                                           static_cast<const TechnoClass*>(object), value, scan.zone)
+            && value > result.value) {
+            result.object = object;
+            result.value = value;
+        }
+    }
+}
+
+struct Statistics {
+    uint64_t jobs = 0, parallel = 0, verified = 0, candidates = 0;
+    uint64_t hash = 14695981039346656037ULL;
+    bool enabled = std::getenv("RED_ALERT_DS_PLUS_TARGET_STATS") != nullptr;
+    ~Statistics()
+    {
+        if (enabled) std::fprintf(stderr,
+            "TARGET_SCAN jobs=%llu parallel=%llu verified=%llu candidates=%llu hash=%016llx frame=%d\n",
+            (unsigned long long)jobs, (unsigned long long)parallel, (unsigned long long)verified,
+            (unsigned long long)candidates, (unsigned long long)hash, Frame);
+    }
+};
+}
+#endif
+
+bool RGDS_Parallel_Target_Scan(const TechnoClass* source, int method, int mask, int zone,
+                               const ObjectClass*& best, int& value)
+{
+#ifdef RED_ALERT_DS_PLUS
+    // Only the full ground scan uses this phase. The simulation stays on the
+    // caller, which cannot delete objects or change the layer until Run returns.
+    if (!RGDS_Video_Enabled()) return false;
+    static const bool enabled = !std::getenv("RED_ALERT_DS_PLUS_THREADS")
+        || std::getenv("RED_ALERT_DS_PLUS_THREADS")[0] != '0';
+    const int count = Map.Layer[LAYER_GROUND].Count();
+    if (count < 768) return false;
+    ParallelScan* pool = enabled ? RGDS_Workers() : nullptr;
+    static Statistics statistics;
+    Scan scan;
+    scan.source = source;
+    scan.method = static_cast<ThreatType>(method);
+    scan.mask = mask;
+    scan.zone = zone;
+    if (pool) pool->Run(count, Evaluate, &scan);
+    else Evaluate(&scan, 0, count, 0);
+
+    const ObjectClass* parallel_best = best;
+    int parallel_value = value;
+    // Contiguous lanes and strict comparison retain the original first-wins
+    // tie break, including an aircraft selected before the ground scan.
+    for (const auto& result : scan.result) {
+        if (result.value > parallel_value) {
+            parallel_best = result.object;
+            parallel_value = result.value;
+        }
+    }
+    static const bool verify = std::getenv("RED_ALERT_DS_PLUS_VERIFY_TARGETS") != nullptr;
+    if (verify) {
+        Scan reference;
+        reference.source = source;
+        reference.method = scan.method;
+        reference.mask = mask;
+        reference.zone = zone;
+        Evaluate(&reference, 0, count, 0);
+        const Result& result = reference.result[0];
+        const ObjectClass* expected = result.value > value ? result.object : best;
+        const int expected_value = result.value > value ? result.value : value;
+        if (parallel_best != expected || parallel_value != expected_value) {
+            std::fprintf(stderr, "Target scan mismatch at frame %d\n", Frame);
+            std::abort();
+        }
+        ++statistics.verified;
+    }
+    if (statistics.enabled) {
+        ++statistics.jobs;
+        statistics.parallel += bool(pool);
+        statistics.candidates += count;
+        const uint32_t words[] = {uint32_t(Frame), uint32_t(source->As_Target()),
+            uint32_t(parallel_best ? parallel_best->As_Target() : TARGET_NONE), uint32_t(parallel_value)};
+        for (uint32_t word : words) statistics.hash = (statistics.hash ^ word) * 1099511628211ULL;
+    }
+    best = parallel_best;
+    value = parallel_value;
+    return true;
+#else
+    return false;
+#endif
+}
