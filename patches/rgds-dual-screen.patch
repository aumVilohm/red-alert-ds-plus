+static int Find_RGDS_Display(const char* connector)
+{
+    for (int i = 0; i < SDL_GetNumVideoDisplays(); ++i) {
+        const char* name = SDL_GetDisplayName(i);
+        if (name && std::strstr(name, connector)) {
+            return i;
+        }
+    }
+    return -1;
+}
