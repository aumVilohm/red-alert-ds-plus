+bool Map_Video_Mouse(uint32_t window_id, int window_x, int window_y, int& game_x, int& game_y, bool clamp)
+{
+    if (!Is_Game_Video_Window(window_id) || !renderer) {
+        return false;
+    }
+    Refresh_RGDS_Viewport();
+    int ww, wh, ow, oh;
+    SDL_GetWindowSize(window, &ww, &wh);
+    SDL_GetRendererOutputSize(renderer, &ow, &oh);
+    if (RGDS_Video_Enabled()) {
+        int px, py;
+        if (!RGDS_Map_Point(window_x, window_y, ww, wh, ow, oh, 0, 0, ow, oh,
+                            1024, 768, px, py, clamp)) return false;
+        if (RGDS_View().active && !rgds_movie_mode) return RGDS_Project_Point(RGDS_View(), px, py, game_x, game_y);
+        game_x = px * 5 / 8;
+        game_y = py * 5 / 8;
+        return true;
+    }
+    return RGDS_Map_Point(window_x, window_y, ww, wh, ow, oh,
+                          render_dst.x, render_dst.y, render_dst.w, render_dst.h,
+                          hwcursor.GameW, hwcursor.GameH, game_x, game_y, clamp);
+}
