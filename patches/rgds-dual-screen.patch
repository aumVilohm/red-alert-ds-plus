 unsigned char WWKeyboardClassSDL2::Get_Scroll_Direction()
 {
+    if (RGDS_Video_Enabled()) return RGDS_Scroll_Direction();
     return ScrollDirection;
 }
 
+float WWKeyboardClassSDL2::Get_Scroll_Speed()
+{
+    if (!RGDS_Video_Enabled() || !RGDS_View().active) return 1.0f;
+    if (int(Down(SDL_SCANCODE_RIGHT)) != int(Down(SDL_SCANCODE_LEFT))
+        || int(Down(SDL_SCANCODE_DOWN)) != int(Down(SDL_SCANCODE_UP))) return 1.0f;
+    const bool left = ControllerLeftXAxis || ControllerLeftYAxis;
+    const int x = left ? ControllerLeftXAxis : ControllerRightXAxis;
+    const int y = left ? ControllerLeftYAxis : ControllerRightYAxis;
+    const int magnitude = std::min(32767, std::max(std::abs(x), std::abs(y)));
+    const int deadzone = left ? CONTROLLER_L_DEADZONE : CONTROLLER_R_DEADZONE;
+    if (magnitude <= deadzone) return 1.0f;
+    return 2.0f + 2.0f * (magnitude - deadzone) / (32767 - deadzone);
+}
+
+ScrollDirType WWKeyboardClassSDL2::RGDS_Scroll_Direction()
+{
+    int x = int(Down(SDL_SCANCODE_RIGHT)) - int(Down(SDL_SCANCODE_LEFT));
+    int y = int(Down(SDL_SCANCODE_DOWN)) - int(Down(SDL_SCANCODE_UP));
+    if (!x && !y) {
+        const bool left = ControllerLeftXAxis || ControllerLeftYAxis;
+        const int ax = left ? ControllerLeftXAxis : ControllerRightXAxis;
+        const int ay = left ? ControllerLeftYAxis : ControllerRightYAxis;
+        x = (ax > 0) - (ax < 0);
+        y = (ay > 0) - (ay < 0);
+    }
+    const ScrollDirType dirs[] = {SDIR_NW, SDIR_N, SDIR_NE, SDIR_W, SDIR_NONE,
+                                  SDIR_E, SDIR_SW, SDIR_S, SDIR_SE};
+    return dirs[(y + 1) * 3 + x + 1];
+}
